# Copy to .env for local overrides (never commit .env).
# Go API (cmd/api)
ADDR=:8080

# PostgreSQL (deploy/docker-compose.yml)
POSTGRES_USER=manageria
POSTGRES_PASSWORD=manageria
POSTGRES_DB=manageria
POSTGRES_PORT=5432
DATABASE_URL=postgres://manageria:manageria@localhost:5432/manageria?sslmode=disable